NODE_ENV=test
PORT=3001

# Test Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=test
DB_PASSWORD=test
DB_DATABASE=demi_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT
JWT_SECRET=test-secret-key-for-testing-only-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OTP
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW=10
OTP_RATE_LIMIT_MAX_REQUESTS=5
OTP_COOLDOWN_MINUTES=15

# AES Encryption
AES_SECRET_KEY=test-aes-key-32-characters-minimum-length-required

# Device Signature
DEVICE_SIGNATURE_EXPIRY_MINUTES=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Mock for testing)
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=SG.test-key
EMAIL_FROM=test@example.com

# SMS (Mock for testing)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACtest-sid
TWILIO_AUTH_TOKEN=test-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Mock for testing)
PUSH_PROVIDER=mock

# File Upload
UPLOAD_DIR=./uploads-test
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX_REQUESTS=100

# FCM (Mock for testing)
FCM_PROJECT_ID=test-project
FCM_PRIVATE_KEY=test-key
FCM_CLIENT_EMAIL=test@test.iam.gserviceaccount.com

# Google OAuth (Mock for testing)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
