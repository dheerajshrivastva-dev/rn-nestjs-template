{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "modules/notification/templates/**/*.hbs",
        "outDir": "dist"
      },
      {
        "include": "modules/notification/templates/**/*.png",
        "outDir": "dist"
      },
      {
        "include": "../public/**/*",
        "outDir": "dist",
        "flat": false
      }
    ]
  }
}
