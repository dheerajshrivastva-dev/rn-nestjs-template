<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{subject}}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #333333;
            background-color: #f4f4f4;
            padding: 20px;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .header {
            background: linear-gradient(135deg, #f05a5a 0%, #c0392b 100%);
            padding: 24px 20px;
            text-align: center;
        }

        .header h1 {
            color: #ffffff;
            font-size: 18px;
            font-weight: 500;
            margin: 8px 0 0 0;
            opacity: 0.85;
            letter-spacing: 0.5px;
        }

.content {
            padding: 40px 30px;
        }

        .content h2 {
            color: #333333;
            font-size: 24px;
            margin-bottom: 20px;
        }

        .content p {
            color: #666666;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .button {
            display: inline-block;
            padding: 14px 32px;
            margin: 20px 0;
            background: linear-gradient(135deg,#f05a5a 0%,#b83e3e 100%);;
            color: #ffffff;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            font-size: 16px;
            transition: transform 0.2s;
        }

        .button:hover {
            transform: translateY(-2px);
        }

        .otp-container {
            background-color: #f8f9fa;
            border: 2px dashed #f05a5a;
            border-radius: 8px;
            padding: 20px;
            margin: 25px 0;
            text-align: center;
        }

        .otp-code {
            font-size: 36px;
            font-weight: bold;
            letter-spacing: 8px;
            color: #f05a5a;
            margin: 10px 0;
            font-family: 'Courier New', monospace;
        }

        .info-box {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }

        .info-box p {
            color: #856404;
            margin: 0;
            font-size: 14px;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 30px;
            text-align: center;
            border-top: 1px solid #e9ecef;
        }

        .footer p {
            color: #6c757d;
            font-size: 14px;
            margin: 5px 0;
        }

        .social-links {
            margin: 20px 0;
        }

        .social-links a {
            display: inline-block;
            margin: 0 10px;
            color: #f05a5a;
            text-decoration: none;
            font-size: 14px;
        }

        .divider {
            height: 1px;
            background-color: #e9ecef;
            margin: 20px 0;
        }

        @media only screen and (max-width: 600px) {
            body {
                padding: 10px;
            }

            .email-container {
                border-radius: 0;
            }

            .content {
                padding: 30px 20px;
            }

            .header h1 {
                font-size: 24px;
            }

            .otp-code {
                font-size: 28px;
                letter-spacing: 4px;
            }
        }
    </style>
</head>
<body>
    <div class="email-container">
        <!-- Header -->
        <div class="header">
            <img src="data:image/png;base64," alt="Duetech" style="height: 72px; width: 72px; border-radius: 16px; display: block; margin: 0 auto 10px auto; object-fit: contain;" />
            <h1>{{headerTitle}}</h1>
        </div>

        <!-- Content -->
        <div class="content">
            {{{body}}}
        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="divider"></div>
            <p><strong>Duetech</strong></p>
            <p>Secure Device Management Solutions</p>
            <div class="social-links">
                <a href="#">Support</a> |
                <a href="#">Privacy Policy</a> |
                <a href="#">Terms of Service</a>
            </div>
            <p style="margin-top: 20px;">
                &copy; {{year}} Duetech. All rights reserved.
            </p>
            <p style="font-size: 12px; color: #9ca3af; margin-top: 15px;">
                This email was sent to {{toEmail}}. If you didn't request this email, please ignore it.
            </p>
        </div>
    </div>
</body>
</html>
