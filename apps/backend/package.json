{
  "name": "forge-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "NODE_ENV=test jest --config ./test/jest-e2e.json --watch",
    "test:e2e:cov": "NODE_ENV=test jest --config ./test/jest-e2e.json --coverage",
    "test:e2e:debug": "NODE_ENV=test node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./test/jest-e2e.json --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "test:db:up": "docker compose -f docker-compose.test.yml -p forge-test up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml -p forge-test down",
    "test:db:clean": "docker compose -f docker-compose.test.yml -p forge-test down -v",
    "dev:db:up": "docker compose -f docker-compose.dev.yml -p forge-backend up -d",
    "dev:db:down": "docker compose -f docker-compose.dev.yml -p forge-backend down",
    "dev:db:logs": "docker compose -f docker-compose.dev.yml -p forge-backend logs -f",
    "test:auto": "./scripts/run-all-tests.sh",
    "postman:generate": "ts-node scripts/generate-postman-tests.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/typeorm.config.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/typeorm.config.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/typeorm.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
