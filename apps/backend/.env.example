# Application
NODE_ENV=development
PORT=3000
APP_NAME=forge-backend


# OpenTelemetry / Jaeger Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres123
DB_DATABASE=forge_db
DB_SYNC=false  # NEVER set to true - use migrations instead
DB_MIGRATIONS_RUN=false  # Set to true to auto-run migrations on app start (use with caution)
DB_LOGGING=true

# Redis (For caching, sessions, and Bull queues)
REDIS_HOST=localhost
REDIS_PORT=6380  # Using 6380 to avoid conflict with local Redis on 6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# Encryption
AES_SECRET_KEY=your-32-character-aes-secret-key-change-this-in-production!!

# OTP Configuration
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_COUNT=5
OTP_RATE_LIMIT_WINDOW_MINUTES=10
OTP_COOLDOWN_MINUTES=15


CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_API_KEY=""

# =====================================
# NOTIFICATION SYSTEM (Plug & Play Providers)
# =====================================

# Email Provider Selection (Plug & Play Architecture)
# Options: 'msg91' | 'sendgrid' | 'smtp'
# Development: use 'smtp' (Mailpit) | Production: use 'sendgrid' or 'msg91'
EMAIL_PROVIDER=smtp
EMAIL_PROVIDER_FALLBACK=

# SMS Provider Selection (Plug & Play Architecture)
# Options: 'msg91' | 'twilio' | 'sns'
SMS_PROVIDER=msg91
SMS_PROVIDER_FALLBACK=twilio

# Push Notification Provider
# Options: 'fcm' | 'apns' | 'onesignal'
PUSH_PROVIDER=fcm

# Default Email Settings
EMAIL_FROM=noreply@demigod.com
EMAIL_FROM_NAME=Demigod

# --- MSG91 Provider (Unified Email + SMS) ---
# Get your API key from: https://msg91.com/
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_EMAIL_DOMAIN=demigod.com
MSG91_SENDER_ID=DEMIGD
MSG91_DLT_ENTITY_ID=your_dlt_entity_id  # India DLT registration
MSG91_OTP_TEMPLATE_ID=your_otp_template_id

# --- SendGrid Provider (Email Alternative) ---
# Get your API key from: https://sendgrid.com/
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# --- SMTP Provider ---
# Development: point at Mailpit (SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false)
# Production: use Hostinger or another SMTP provider (SMTP_PORT=465, SMTP_SECURE=true)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@demi.local
SMTP_FROM_NAME=Duetech

# --- Twilio Provider (SMS Alternative) ---
# Get credentials from: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# --- AWS SNS Provider (SMS Alternative) ---
# AWS SNS can also be used for SMS
AWS_SNS_REGION=ap-south-1

# File Storage
# For Development: Use MinIO (http://localhost:9001)
# For Production: Use AWS S3
STORAGE_TYPE=local  # local | s3 | minio
STORAGE_PATH=./uploads

# MinIO (S3-compatible for development)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=demi-documents

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=demi-documents-prod

# --- Firebase Cloud Messaging (FCM) ---
# Get service account from: Firebase Console > Project Settings > Service Accounts
# Option 1: Use service account file path (recommended for local development)
FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# Option 2: Use service account JSON string (for cloud environments like Heroku, Railway)
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# --- Apple Push Notification Service (APNS - Future) ---
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_team_id
APNS_KEY_PATH=/path/to/AuthKey.p8
APNS_BUNDLE_ID=com.demigod.app

# Device Authentication
DEVICE_SIGNATURE_EXPIRY_MINUTES=5
DEVICE_MAX_FAILED_AUTH_ATTEMPTS=10
DEVICE_RATE_LIMIT_PER_MINUTE=100

# QR Code
UNIQUE_CODE_LENGTH=256
UNIQUE_CODE_EXPIRY_DAYS=7

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Notification Limits
EMAIL_DAILY_LIMIT_PER_USER=1000
SMS_DAILY_LIMIT_PER_USER=50
EMAIL_MAX_RETRY_ATTEMPTS=3
SMS_MAX_RETRY_ATTEMPTS=3
PUSH_MAX_RETRY_ATTEMPTS=3

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Swagger — restricted to Tailscale IPs (100.x.x.x) in production
# Comma-separated IP prefixes. Default covers full Tailscale range.
# Add your specific Tailscale IP: run "tailscale ip -4" on your machine
SWAGGER_ALLOWED_IPS=100.

# Rate Limiting (default applied to all endpoints not explicitly decorated)
# TTL is in seconds — converted to ms in app.module.ts
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Auth — Session & Rate-Limit Config
AUTH_MAX_SESSIONS=10                  # Max concurrent active sessions per user
AUTH_RL_SHORT_WINDOW_SECS=900         # 15 min window (3-failure lockout)
AUTH_RL_MID_WINDOW_SECS=3600          # 1 h window   (5-failure lockout)
AUTH_RL_LONG_WINDOW_SECS=86400        # 24 h window  (10-failure lockout)
AUTH_RL_IP_WINDOW_SECS=300            # 5 min IP window
AUTH_RL_SHORT_THRESHOLD=3             # Failures before 15-min lock
AUTH_RL_MID_THRESHOLD=5              # Failures before 1-h lock
AUTH_RL_LONG_THRESHOLD=10             # Failures before 24-h lock
AUTH_RL_IP_THRESHOLD=10               # IP failures before 5-min block

# Biometric
BIOMETRIC_EXPIRY_DAYS=90              # Days before biometric registration expires
BIOMETRIC_CHALLENGE_TTL_SECS=120      # Seconds a biometric challenge is valid

# Logging
LOG_LEVEL=debug
