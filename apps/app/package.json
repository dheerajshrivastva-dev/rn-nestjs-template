{
  "name": "forge-app",
  "version": "0.0.1",
  "buildNumber": 11,
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8082",
    "ios": "react-native run-ios --port 8082",
    "lint": "eslint .",
    "start": "react-native start --port 8082",
    "test": "jest",
    "prebuild:android:release": "node -e \"const fs=require('fs'),p=require('./package.json');p.buildNumber=(p.buildNumber||0)+1;fs.writeFileSync('./package.json',JSON.stringify(p,null,2)+'\\n');console.log('buildNumber →',p.buildNumber)\"",
    "build:android:release": "cd android && ENVFILE=../.env.production ./gradlew assembleRelease",
    "postbuild:android:release": "git add package.json && git commit -m \"chore(forge-app): bump buildNumber to $(node -p \"require('./package.json').buildNumber\")\" --no-verify",
    "build:android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
